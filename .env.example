# Connect6 environment template. Copy to .env and adjust.
# Load it with: set -a; . ./.env; set +a

CONNECT6_HOST=127.0.0.1
CONNECT6_PORT=18090
CONNECT6_BASE_PATH=/connect6
CONNECT6_ENGINE=./backend/engine
CONNECT6_MAX_ACTIVE_GAMES=5
CONNECT6_SESSION_TTL_MS=1800000
CONNECT6_CLEANUP_INTERVAL_MS=1800000
CONNECT6_ENGINE_TIMEOUT_MS=30000

# Optional paths for the start/restart scripts.
# CONNECT6_DIR=/opt/connect6
# CONNECT6_PID_FILE=/opt/connect6/gateway.pid
# CONNECT6_LOG=/opt/connect6/gateway.log
# CONNECT6_WEB_ROOT=/var/www/connect6/game

# Abuse limits (see README "Security and abuse limits").
CONNECT6_MAX_CLIENT_TIME_MS=10000
CONNECT6_MAX_REQUEST_BYTES=20000
CONNECT6_MAX_ENGINE_LINE_BYTES=1048576
CONNECT6_RATE_WINDOW_MS=60000
CONNECT6_RATE_LIMIT_PER_WINDOW=120
CONNECT6_SESSION_RATE_WINDOW_MS=600000
CONNECT6_SESSION_LIMIT_PER_WINDOW=10
